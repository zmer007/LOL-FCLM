# ===== 数据库（MySQL 9.7） =====
DB_NAME=lol
DB_USER=lol
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# ===== JWT 鉴权 =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168

# ===== 管理员账号（首次启动时自动创建，已存在则忽略） =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ===== 上传限制 =====
MAX_VIDEO_MB=200
MAX_IMAGE_MB=5

# ===== 邮箱验证码（SMTP；不配置则注册发码功能不可用） =====
# 示例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USER=xxx@qq.com SMTP_PASSWORD=授权码
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 验证码有效期（秒），同一邮箱重发间隔（秒）
CODE_TTL_SECONDS=600
CODE_RESEND_SECONDS=60

# 复制本文件为 .env 后修改：cp .env.example .env
